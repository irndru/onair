{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/main/.schema/devbox.schema.json",
  "packages": ["go@1.27.0"],
  "env": {
    "CGO_ENABLED": "0"
  },
  "shell": {
    "scripts": {
      "build": "go build -o videobg ./cmd/videobg",
      "install": "go install ./cmd/videobg",
      "test": "go test ./...",
      "lint": "test -z \"$(gofmt -l .)\" && go vet ./... && GOOS=linux go vet ./..."
    }
  }
}
